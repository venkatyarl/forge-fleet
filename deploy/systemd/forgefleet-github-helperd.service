[Unit]
Description=ForgeFleet fail-closed GitHub capability helper
Requires=forgefleet-github-helperd.socket
After=postgresql.service

[Service]
Type=notify
User=ff-github-helper
Group=ff-github-helper
ExecStart=/usr/libexec/forgefleet/ff-github-helperd
LoadCredential=github-app.pem:/etc/forgefleet/github-app.pem
EnvironmentFile=/etc/forgefleet/github-helperd.env
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=2
TimeoutStartSec=10
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=/proc

[Install]
WantedBy=multi-user.target
