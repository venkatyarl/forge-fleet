# Non-secret policy values for forgefleet-falkordb-source-firewall.service.
# Install as /etc/forgefleet/falkordb-source-firewall.env (root:root, 0644).
# These values encode the audited Priya <- Sophie FalkorDB path; revalidate
# interface/address authority before installation on any other host.
FF_FALKOR_INTERFACE=enp3s0
FF_FALKOR_ALLOWED_SOURCE_IPV4=192.168.5.103
FF_FALKOR_DESTINATION_IPV4=192.168.5.104
FF_FALKOR_PORT=63379
